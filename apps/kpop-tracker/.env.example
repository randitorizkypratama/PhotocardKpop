# Turso Database
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# API Configuration
NUXT_PUBLIC_API_BASE_URL=

# Pocamarket API (built-in, no changes needed)
POCAMARKET_API_URL=https://pocamarket.com/apis/card/gb/v2

# TikTok for Developers — Display API (login + video list)
# Portal: https://developers.tiktok.com  → register redirect URI below
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-domain/api/tiktok/callback

# TikTok Shop Seller/Partner API — etalase products
# Portal: https://partner.tiktokshop.com
TIKTOK_SHOP_ACCESS_TOKEN=
TIKTOK_SHOP_BASE_URL=https://open-api.tiktokglobalshop.com
TIKTOK_SHOP_SHOP_CIPHER=

# ── Verified K-pop news engine ─────────────────────────────────────────────
# Cron auth for POST /api/cron/news (and /api/cron/sync). Fail-closed 401 when
# unset. Send as: Authorization: Bearer <CRON_SECRET>
# The news cron fires from GitHub Actions (.github/workflows/news.yml,
# daily 10:00 UTC), so the same value must also exist as the repository
# secret CRON_SECRET (Settings → Secrets and variables → Actions).
CRON_SECRET=

# Machine translation of published headlines (EN ↔ ID) is server-side only and
# keyless: MyMemory (api.mymemory.translated.net), cached in the
# news_translations table, falling back to the verified original wording on any
# failure. No environment variable, no API key, never called from the browser.

# Optional YouTube Data API v3 key for official-channel discovery.
# Server-side only — never exposed to the browser.
YOUTUBE_API_KEY=

# Allowlisted official channels, `artist:channelId` (channel ID, never a display
# name). Uploads are read from the channel's uploads playlist (1 quota unit per
# call instead of 100 for a search). Example:
#   YOUTUBE_CHANNELS=aespa:UCxxxxxxxxxxxxxxxxxxxxxx,ive:UCyyyyyyyyyyyyyyyyyyyyyy
YOUTUBE_CHANNELS=

# Naver Search API — Korean news discovery. Get an app at
# https://developers.naver.com → 애플리케이션 등록 → enable 검색(Search).
# Leave empty to disable Korean discovery; the run then behaves as before.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Outbound fetch timeout for one request, in ms (1000–30000, default 6000).
NEWS_FETCH_TIMEOUT=6000

# How long a VERIFIED story stays verified before it must be re-checked,
# in ms (default 21600000 = 6 h).
NEWS_RECHECK_INTERVAL=21600000

# Minimum deterministic score required by hard gate 10 (0–100, default 90).
VERIFICATION_MIN_SCORE=90

# Optional comma-separated publisher allowlist. Empty = any public domain
# (SSRF guards still apply); non-empty = only these hosts are ever fetched.
ALLOWED_SOURCE_DOMAINS=

# Bounded work per cron run (Vercel Hobby function timeout headroom).
# NEWS_MAX_ARTICLES_PER_RUN caps how many *stories are processed*; discovery is
# deliberately wider (NEWS_DISCOVERY_CANDIDATES_PER_ARTIST, default 12) so the
# same event can be found at several publishers and independently corroborated.
NEWS_MAX_ARTICLES_PER_RUN=9
NEWS_DISCOVERY_CANDIDATES_PER_ARTIST=12
NEWS_RUN_BUDGET_MS=240000
NEWS_MAX_RETRIES=1
NEWS_MAX_RESPONSE_BYTES=1048576
NEWS_MAX_AGE_DAYS=14

# Politeness: minimum gap between two requests to the same host (ms,
# 0–10000, default 1000), how long a host that answered 429 is left alone
# (ms, default 60000), and the largest sitemap body read (bytes, default
# 4194304 — sitemaps are far larger than a feed, feeds keep the 1 MB cap).
NEWS_HOST_MIN_INTERVAL_MS=1000
NEWS_HOST_COOLDOWN_MS=60000
NEWS_SITEMAP_MAX_BYTES=4194304

# ── AI rewrite (fanbase blog at /news) ─────────────────────────────────────
# The weekly run turns the articles above into Indonesian fanbase-blog DRAFTS.
# Nothing is published automatically: an admin reviews and approves each draft
# in /admin/news. Provider: Google Gemini only.
#
# One or more API keys, comma-separated. Several keys (different Google
# accounts/projects) turn a quota wall into a failover: a key that answers
# 429 / RESOURCE_EXHAUSTED is put on cooldown and the next key is used.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEYS=

# Model name. Must exist in the current model list — Google renames these
# often, so this is env-driven rather than hard-coded.
GEMINI_MODEL=gemini-flash-lite-latest

# Master switch; false makes the weekly run a no-op.
REWRITE_ENABLED=true

# Hard cap on drafts per run (1–50, default 5).
REWRITE_MAX_PER_RUN=5

# Per-request timeout for one generation call (ms, default 90000). The rewrite
# request is large, so this is generous; the key pool — not a transport retry —
# is what handles a slow or overloaded model.
REWRITE_TIMEOUT_MS=90000

# Response token ceiling (512–32768, default 4096).
REWRITE_MAX_TOKENS=4096

# How long a key that reported quota/rate-limit is skipped (ms, default 900000).
REWRITE_KEY_COOLDOWN_MS=900000

# A failed rewrite is not retried before this has elapsed (ms, default 21600000).
REWRITE_RETRY_FAILED_MS=21600000

# Largest amount of source text handed to the model (chars, default 6000).
REWRITE_MAX_INPUT_CHARS=6000

# Sampling temperature (0–1, default 0.7).
REWRITE_TEMPERATURE=0.7

